# PRODUCTION env for the pkos-api container (compose env_file). Copy to .env on the server.
# Dev env lives in apps/api/.env (see apps/api/.env.example).

# Shared Postgres via docker network 'web', db 'pkos' (pgvector enabled). Password: VPS only.
DATABASE_URL=postgres://pkos:CHANGE_ME@infra-postgres:5432/pkos

# Ollama container (same compose project, network 'web')
OLLAMA_URL=http://pkos-ollama:11434

PORT=3002

# Host IP the api port is published on — Tailscale-only exposure.
# Set to the output of `tailscale ip -4`. NEVER 0.0.0.0 (docker published ports bypass UFW).
TAILSCALE_IP=CHANGE_ME

# Knowledge vault mount inside the container (compose mounts /srv/data/knowledge → /vault)
VAULT_PATH=/vault

# Bearer key for the OpenAI-compat surface (/v1/*); also handed to Open WebUI as
# OPENAI_API_KEY by compose. Generate: openssl rand -hex 24. Unset ⇒ /v1 always 401s.
OPENAI_COMPAT_API_KEY=CHANGE_ME

# Sermon audio dir inside the api+worker containers (compose mounts
# /srv/data/uploads/pkos → /uploads; create the host dir, chown 1000:1000)
UPLOADS_PATH=/uploads

# Transcription worker (pkos-worker)
# WHISPER_MODEL=small
# POLL_INTERVAL_SEC=5
# Re-queue `processing` jobs untouched for this long (worker died mid-job)
# STALE_PROCESSING_MIN=60

# Chat model served by ollama
# LLM_MODEL=qwen3:14b

# Cosine similarity cutoff below which /chat treats retrieval as "nothing relevant"
# RETRIEVAL_MIN_SCORE=0.5

# LLM call budget. Default 120s; raised — shared ollama queues.
LLM_TIMEOUT_MS=420000

# Gym-log extraction (log_workout_text): dedicated ollama structured-output call
# EXTRACT_MODEL=qwen3:14b      # default: LLM_MODEL
# EXTRACT_TIMEOUT_MS=420000    # own generous budget (thinking enabled)

# think:true for models that ignore think:false (qwen3:30b-a3b) — reasoning
# goes to the separate thinking field, content stays clean.
LLM_THINK=true

# Workout-text extraction model — pinned to the model the parse criteria were
# verified on (chat model is swappable without regressing extraction).
EXTRACT_MODEL=qwen3:14b

# Fixed JWT signing key for webui (openssl rand -hex 32) — else restarts log you out
WEBUI_SECRET_KEY=CHANGE_ME

# web_search tool → self-hosted SearXNG (internal web network)
SEARXNG_URL=http://pkos-searxng:8080
# WEB_SEARCH_TIMEOUT_MS=15000
