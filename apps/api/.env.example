# Copy to .env (never commit .env). DEV env — native api on localhost.
# Prod env lives at repo root .env (compose env_file, see root .env.example).

# Shared local Postgres (jepsn1/infra), db 'pkos' (pgvector enabled)
DATABASE_URL=postgres://pkos:CHANGE_ME@127.0.0.1:5432/pkos

# pkos-ollama container, port published on localhost for dev
OLLAMA_URL=http://127.0.0.1:11434

PORT=3002

# Knowledge vault (git checkout of jepsn1/knowledge). Default if unset: /srv/data/knowledge
# VAULT_PATH=/srv/data/knowledge

# Embedding model served by ollama (768-dim). Pull once:
#   docker exec pkos-ollama ollama pull nomic-embed-text
# EMBEDDING_MODEL=nomic-embed-text

# Chat model served by ollama (pull once: docker exec pkos-ollama ollama pull qwen3:14b)
# LLM_MODEL=qwen3:14b

# Cosine similarity cutoff below which /chat treats retrieval as "nothing relevant"
# RETRIEVAL_MIN_SCORE=0.5
